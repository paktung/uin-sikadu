rules_version = '2';

// Aturan ini contoh awal, sesuaikan lagi sebelum production.
// Pasang lewat Firebase Console > Firestore Database > Rules,
// atau `firebase deploy --only firestore:rules` kalau pakai Firebase CLI.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().level == 'admin' && myProfile().isActive == true;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isDosenOwnsKelas(kelasId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/kelasKuliah/$(kelasId)).data.dosenId == request.auth.uid;
    }

    // ---------------- users ----------------
    match /users/{uid} {
      // Bootstrap: izinkan pembuatan akun admin PERTAMA saat koleksi masih kosong.
      // Setelah admin pertama ada, hanya admin yang boleh membuat/mengubah user lain.
      allow create: if (isOwner(uid) && request.resource.data.level == 'admin'
                          && !exists(/databases/$(database)/documents/users/$(uid)))
                    || isAdmin();
      allow read:   if isOwner(uid) || isAdmin();
      allow update: if isAdmin() || (isOwner(uid) && request.resource.data.level == resource.data.level);
      allow delete: if isAdmin();
    }

    // ---------------- dosen & mahasiswa profiles ----------------
    match /dosen/{uid} {
      allow read:   if isSignedIn();
      allow write:  if isAdmin() || isOwner(uid);
    }

    match /mahasiswa/{uid} {
      allow read:   if isSignedIn();
      allow write:  if isAdmin() || isOwner(uid);
    }

    // ---------------- master data akademik ----------------
    // Dosen & mahasiswa perlu BACA data ini untuk dashboard mereka
    // (kelas yang diampu/diambil, mata kuliah, tahun akademik aktif,
    // pengumuman). Menulis/mengubah tetap admin-only.
    match /fakultas/{id}      { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /programStudi/{id}  { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /mataKuliah/{id}    { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /tahunAkademik/{id} { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /kelasKuliah/{id}   { allow read: if isSignedIn(); allow write: if isAdmin(); }
    match /pengumuman/{id}    { allow read: if isSignedIn(); allow write: if isAdmin(); }

    // ---------------- KRS (roster kelas) ----------------
    // Diisi oleh DOSEN pemilik kelas (LMS: dosen yang menentukan peserta),
    // bukan mahasiswa mendaftar sendiri. Mahasiswa hanya bisa membaca
    // (lihat kelas.html mereka sendiri), tidak bisa create/delete.
    match /krs/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isDosenOwnsKelas(request.resource.data.kelasKuliahId);
      allow delete: if isAdmin() || isDosenOwnsKelas(resource.data.kelasKuliahId);
      allow update: if isAdmin();
    }

    // ---------------- Materi (dosen pemilik kelas / admin) ----------------
    match /materi/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isDosenOwnsKelas(request.resource.data.kelasKuliahId);
      allow update, delete: if isAdmin() || isDosenOwnsKelas(resource.data.kelasKuliahId);
    }

    // ---------------- Pertemuan & Presensi ----------------
    match /pertemuan/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isDosenOwnsKelas(request.resource.data.kelasKuliahId);
      allow update, delete: if isAdmin() || isDosenOwnsKelas(resource.data.kelasKuliahId);
    }
    match /absensi/{id} {
      // Disederhanakan untuk MVP: siapapun yang login boleh baca/tulis.
      // TODO tahap berikutnya: batasi tulis hanya untuk dosen pemilik kelas
      // (butuh nested-get pertemuan -> kelasKuliah -> dosenId).
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // ---------------- Tugas, Pengumpulan, Nilai (disiapkan untuk tahap berikutnya) ----------------
    match /tugas/{id} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || isDosenOwnsKelas(request.resource.data.kelasKuliahId);
      allow update, delete: if isAdmin() || isDosenOwnsKelas(resource.data.kelasKuliahId);
    }
    match /tugasSubmission/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.mahasiswaId == request.auth.uid;
      allow update: if isAdmin() || isSignedIn(); // disederhanakan; perketat nanti
    }
    match /nilai/{id} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // disederhanakan; perketat nanti
    }

    // ---------------- everything else (materi, tugas, nilai, dst) ----------------
    // Placeholder ketat: tolak dulu semua akses ke koleksi lain sampai
    // masing-masing dirancang aturannya (KRS, nilai, presensi, dst - tahap
    // berikutnya).
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
